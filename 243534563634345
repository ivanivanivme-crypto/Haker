------------------------------------------------------------

local function SendTitleInventory(player)

	local ownedTitles =
		GetOwnedTitles(player)

	local folder =
		player:FindFirstChild("TitleData")

	if not folder then
		return
	end

	local equipped =
		folder:FindFirstChild(
			"EquippedTitle"
		)

	TitleCustomizeRemote:FireClient(
		player,
		"Inventory",
		{
			Titles = ownedTitles,
			Equipped = equipped and equipped.Value or "",
		}
	)
end

------------------------------------------------------------
-- EQUIP TITLE
------------------------------------------------------------

local function EquipTitle(
	player,
	titleName
)

	if typeof(titleName) ~= "string" then
		return
	end

	if titleName == "" then

		local folder =
			player:FindFirstChild("TitleData")

		if not folder then
			return
		end

		local equipped =
			folder:FindFirstChild(
				"EquippedTitle"
			)

		if not equipped then
			return
		end

		equipped.Value = ""

		ApplyTitle(player)
		SaveData(player)
		SendTitleInventory(player)

		return
	end

	--------------------------------------------------------
	-- TITLE EXISTS
	--------------------------------------------------------

	local title =
		GetTitleInfo(titleName)

	if not title then

		warn(
			"[TitleSystem] Invalid title from "
				.. player.Name
				.. ": "
				.. titleName
		)

		return
	end

	--------------------------------------------------------
	-- UNLOCK CHECK
	--------------------------------------------------------

	if not IsTitleUnlocked(
		player,
		titleName
		) then

		warn(
			"[TitleSystem] "
				.. player.Name
				.. " tried to equip locked title: "
				.. titleName
		)

		return
	end

	--------------------------------------------------------
	-- DATA
	--------------------------------------------------------

	local folder =
		player:FindFirstChild(
			"TitleData"
		)

	if not folder then
		return
	end

	local equipped =
		folder:FindFirstChild(
			"EquippedTitle"
		)

	if not equipped then
		return
	end

	--------------------------------------------------------
	-- EQUIP
	--------------------------------------------------------

	equipped.Value =
		titleName

	UpdateTitleInventory(player)

	ApplyTitle(player)

	SaveData(player)

	SendTitleInventory(player)

	print(
		"🏷️ "
			.. player.Name
			.. " equipped "
			.. titleName
	)
end


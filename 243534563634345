		healthFill

	local red =
		Color3.fromRGB(255, 45, 45)

	local yellow =
		Color3.fromRGB(255, 215, 45)

	local green =
		Color3.fromRGB(50, 220, 75)

	local white =
		Color3.fromRGB(255, 255, 255)

	local function UpdateHealth()

		if
			not humanoid
			or not humanoid.Parent
			or not healthBackground.Parent
		then
			return
		end

		local maxHealth =
			humanoid.MaxHealth

		if maxHealth <= 0 then

			healthBackground.Visible = false
			return

		end

		local health =
			math.clamp(
				humanoid.Health / maxHealth,
				0,
				1
			)

		if health >= 0.999 then

			healthBackground.Visible = false
			return

		end

		healthBackground.Visible = true

		local healthColor

		if health <= 0.5 then

			healthColor =
				red:Lerp(
					yellow,
					health / 0.5
				)

		else

			healthColor =
				yellow:Lerp(
					green,
					(health - 0.5) / 0.5
				)

		end

		local lightColor =
			healthColor:Lerp(
				white,
				0.08
			)

		healthGradient.Color =
			ColorSequence.new({

				ColorSequenceKeypoint.new(
					0,
					healthColor
				),

				ColorSequenceKeypoint.new(
					0.5,
					lightColor
				),

				ColorSequenceKeypoint.new(
					1,
					healthColor
				),

			})

		TweenService:Create(
			healthFill,

			TweenInfo.new(
				0.18,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			{
				Size =
					UDim2.new(
						health,
						0,
						1,
						0
					)
			}

		):Play()

	end

	local healthConnection =
		humanoid.HealthChanged:Connect(
			UpdateHealth
		)

	local maxHealthConnection =
		humanoid:GetPropertyChangedSignal(
			"MaxHealth"
		):Connect(
		UpdateHealth
	)

	billboard.Destroying:Connect(function()

		if healthConnection then
			healthConnection:Disconnect()
		end

		if maxHealthConnection then
			maxHealthConnection:Disconnect()
		end

	end)

	UpdateHealth()

	return healthBackground
end


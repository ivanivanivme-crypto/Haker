------------------------------------------------------------
-- LOAD DATA
------------------------------------------------------------

local function LoadData(player)

	local _, equippedTitle = CreateTitleData(player)

	local success, data = pcall(function()

		return TitleStore:GetAsync(
			"Player_" .. player.UserId
		)

	end)

	if not success then
		warn(
			"[TitleSystem] Failed to load data for "
				.. player.Name
		)

		return
	end

	if type(data) ~= "table" then
		return
	end

	--------------------------------------------------------
	-- NEW DATA
	--------------------------------------------------------

	if type(data.EquippedTitle) == "string" then
		equippedTitle.Value = data.EquippedTitle
	end

	--------------------------------------------------------
	-- OLD DATA COMPATIBILITY
	--------------------------------------------------------

	if equippedTitle.Value == ""
		and type(data.SelectedTitle) == "string"
	then
		equippedTitle.Value = data.SelectedTitle
	end

	--------------------------------------------------------
	-- VALIDATE
	--------------------------------------------------------

	if equippedTitle.Value ~= ""
		and not IsTitleUnlocked(
			player,
			equippedTitle.Value
		)
	then

		equippedTitle.Value = ""

	end

	UpdateTitleInventory(player)
end

------------------------------------------------------------
-- SAVE DATA
------------------------------------------------------------

local function SaveData(player)

	local folder = player:FindFirstChild("TitleData")

	if not folder then
		return
	end

	local equipped = folder:FindFirstChild("EquippedTitle")

	if not equipped then
		return
	end

	local data = {
		EquippedTitle = equipped.Value,
		SelectedTitle = equipped.Value,
	}

	local success, errorMessage = pcall(function()

		TitleStore:UpdateAsync(
			"Player_" .. player.UserId,
			function()
				return data
			end
		)

	end)

	if not success then

		warn(
			"[TitleSystem] Failed to save "
				.. player.Name
				.. ": "
				.. tostring(errorMessage)
		)

	end
end


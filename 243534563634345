------------------------------------------------------------

local function ApplyVIPCharacterGlow(player, character)

	local oldGlow =
		character:FindFirstChild("VIPCharacterGlow")

	if oldGlow then
		oldGlow:Destroy()
	end

	local hasVIP =
		player:GetAttribute("HasVIP") == true

	local isAFK =
		player:GetAttribute("IsAFK") == true

	if not hasVIP and not isAFK then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "VIPCharacterGlow"
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.DepthMode =
		Enum.HighlightDepthMode.Occluded

	highlight.Parent = character

	--------------------------------------------------------
	-- VIP
	--------------------------------------------------------

	if hasVIP and not isAFK then

		highlight.OutlineColor =
			Color3.fromRGB(255, 205, 55)

		return
	end

	--------------------------------------------------------
	-- AFK
	--------------------------------------------------------

	if isAFK and not hasVIP then

		highlight.OutlineColor =
			Color3.fromRGB(80, 205, 255)

		return
	end

	--------------------------------------------------------
	-- VIP + AFK
	--------------------------------------------------------

	if hasVIP and isAFK then

		local blue =
			Color3.fromRGB(80, 205, 255)

		local gold =
			Color3.fromRGB(255, 205, 55)

		task.spawn(function()

			local t = 0

			while
				highlight.Parent
				and character.Parent
				and player.Parent
				and player:GetAttribute("IsAFK") == true
				and player:GetAttribute("HasVIP") == true
			do

				t += 0.025

				local wave =
					(math.sin(t) + 1) / 2

				highlight.OutlineColor =
					blue:Lerp(gold, wave)

				highlight.OutlineTransparency =
					0.05
					+ math.sin(t * 2) * 0.05

				task.wait(0.035)

			end

		end)
	end
end


local function GetFreeParticle(pool)

	for _, particleData in ipairs(pool) do

		if not particleData.Busy then

			particleData.Busy = true

			return particleData

		end

	end

	return nil
end

------------------------------------------------------------
-- UI PARTICLE
------------------------------------------------------------

local function CreateUIParticle(
	effects,
	pool,
	color,
	size,
	lifetime,
	startX,
	startY,
	driftX,
	driftY
)

	local particleData =
		GetFreeParticle(pool)

	if not particleData then
		return
	end

	local particle =
		particleData.Frame

	local gradient =
		particleData.Gradient

	particle.Visible = true

	particle.Size =
		UDim2.fromOffset(size, size)

	particle.Position =
		UDim2.new(
			0.5,
			startX,
			0.5,
			startY
		)

	particle.BackgroundColor3 = color
	particle.BackgroundTransparency = 0.05

	gradient.Color =
		ColorSequence.new({

			ColorSequenceKeypoint.new(
				0,
				Color3.new(1, 1, 1)
			),

			ColorSequenceKeypoint.new(
				0.5,
				color
			),

			ColorSequenceKeypoint.new(
				1,
				color
			),

		})

	gradient.Transparency =
		NumberSequence.new({

			NumberSequenceKeypoint.new(
				0,
				0
			),

			NumberSequenceKeypoint.new(
				1,
				0.5
			),

		})

	local tween = TweenService:Create(
		particle,

		TweenInfo.new(
			lifetime,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			Position =
				UDim2.new(
					0.5,
					startX + driftX,
					0.5,
					startY + driftY
				),

			BackgroundTransparency = 1,

			Size =
				UDim2.fromOffset(
					math.max(1, size * 0.25),
					math.max(1, size * 0.25)
				),
		}
	)

	tween:Play()

	tween.Completed:Once(function()

		if particle.Parent ~= effects then

			particleData.Busy = false
			return

		end

		particle.Visible = false
		particleData.Busy = false

	end)
end

------------------------------------------------------------
-- PARTICLE EFFECT
------------------------------------------------------------

local function StartParticleEffect(
	billboard,
	effects,
	color,
	rate,
	size,
	lifetime,
	style
)

	local particlePool =
		CreateParticlePool(effects)

	task.spawn(function()

		local interval =
			1 / math.max(rate, 1)

		while billboard.Parent do

			local x =
				math.random(-95, 95)

			local y =
				math.random(-8, 12)

			local driftX =
				math.random(-25, 25)

			local driftY =
				math.random(-35, 10)

			local particleColor = color

			if style == "embers" then

				particleColor =
					Color3.fromRGB(
						255,
						math.random(45, 100),
						math.random(20, 45)
					)

				driftY =
					math.random(-55, -20)

				driftX =
					math.random(-18, 18)

			elseif style == "void" then

				particleColor =
					Color3.fromRGB(
						math.random(70, 130),
						math.random(20, 55),
						math.random(170, 235)
					)

				driftX =
					math.random(-35, 35)

				driftY =
					math.random(-25, 25)

			elseif style == "cyan" then

				particleColor =
					Color3.fromRGB(
						math.random(30, 80),
						math.random(150, 220),
						math.random(190, 255)
					)

			elseif style == "gold" then

				particleColor =
					Color3.fromRGB(
						255,
						math.random(150, 220),
						math.random(25, 70)
					)

				driftY =
					math.random(-45, -10)

			elseif style == "pink" then

				particleColor =
					Color3.fromRGB(
						255,
						math.random(35, 90),
						math.random(100, 180)
					)

			elseif style == "rainbow" then

				local hue =
					(os.clock() * 0.15 + math.random()) % 1

				particleColor =
					Color3.fromHSV(
						hue,
						0.75,
						1
					)

				driftX =
					math.random(-30, 30)

				driftY =
					math.random(-35, 15)

			end

			CreateUIParticle(
				effects,
				particlePool,
				particleColor,
				size,
				lifetime,
				x,
				y,
				driftX,
				driftY
			)

			task.wait(interval)

		end

	end)
end


local PARTICLE_POOL_SIZE = 32

local function CreateParticlePool(effects)

	local pool = {}

	for i = 1, PARTICLE_POOL_SIZE do

		local particle = Instance.new("Frame")

		particle.Name = "UIParticle"
		particle.AnchorPoint =
			Vector2.new(0.5, 0.5)

		particle.BackgroundTransparency = 1
		particle.BorderSizePixel = 0
		particle.Visible = false
		particle.ZIndex = 5
		particle.Parent = effects

		local corner = Instance.new("UICorner")
		corner.CornerRadius =
			UDim.new(1, 0)
		corner.Parent = particle

		local gradient = Instance.new("UIGradient")
		gradient.Parent = particle

		pool[i] = {
			Frame = particle,
			Gradient = gradient,
			Busy = false,
		}

	end

	return pool
end


-- PLAYER SETUP
------------------------------------------------------------

local function SetupPlayer(player)

	--------------------------------------------------------
	-- DEFAULT ATTRIBUTES
	--------------------------------------------------------

	if player:GetAttribute("IsAFK") == nil then

		player:SetAttribute(
			"IsAFK",
			false
		)

	end

	if player:GetAttribute("HasVIP") == nil then

		player:SetAttribute(
			"HasVIP",
			false
		)

	end

	--------------------------------------------------------
	-- LEADERSTATS
	--------------------------------------------------------

	local leaderstats =
		player:WaitForChild(
			"leaderstats"
		)

	local bestStreak =
		leaderstats:WaitForChild(
			"BestStreak"
		)

	--------------------------------------------------------
	-- DATA
	--------------------------------------------------------

	CreateTitleData(player)

	LoadData(player)

	CreateDeviceData(player)

	UpdateTitleInventory(player)

	--------------------------------------------------------
	-- STREAK CHANGES
	--------------------------------------------------------

	bestStreak.Changed:Connect(function()

		UpdateTitleInventory(player)

		local folder =
			player:FindFirstChild(
				"TitleData"
			)

		if not folder then
			return
		end

		local equipped =
			folder:FindFirstChild(
				"EquippedTitle"
			)

		if not equipped then
			return
		end

		if equipped.Value ~= ""
			and not IsTitleUnlocked(
				player,
				equipped.Value
			)
		then

			equipped.Value = ""

			ApplyTitle(player)
			SaveData(player)

		end

	end)

	--------------------------------------------------------
	-- CHARACTER
	--------------------------------------------------------

	player.CharacterAdded:Connect(
		function(character)

			local head =
				character:WaitForChild(
					"Head"
				)

			HideDefaultName(
				character
			)

			task.wait(0.5)

			if player.Parent then
				ApplyTitle(player)
			end

		end
	)

	--------------------------------------------------------
	-- VIP
	--------------------------------------------------------

	player:GetAttributeChangedSignal(
		"HasVIP"
	):Connect(function()

		UpdateTitleInventory(player)

		task.wait(0.1)

		if player.Character then
			ApplyTitle(player)
		end

	end)

	--------------------------------------------------------
	-- AFK
	--------------------------------------------------------

	player:GetAttributeChangedSignal(
		"IsAFK"
	):Connect(function()

		task.wait(0.05)

		if player.Character then
			ApplyTitle(player)
		end

	end)

	--------------------------------------------------------
	-- SEND INVENTORY
	--------------------------------------------------------

	task.defer(function()

		if player.Parent then
			SendTitleInventory(player)
		end

	end)

end


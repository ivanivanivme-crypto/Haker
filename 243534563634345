------------------------------------------------------------

TitleRemote.OnServerEvent:Connect(
	function(player, action, value)

		----------------------------------------------------
		-- NEW SYSTEM
		----------------------------------------------------

		if action == "Equip"
			or action == "Select"
		then

			EquipTitle(
				player,
				value
			)

			return
		end

		----------------------------------------------------
		-- OLD SYSTEM
		----------------------------------------------------

		if typeof(action) == "string"
			and value == nil
		then

			EquipTitle(
				player,
				action
			)

			return
		end

		----------------------------------------------------
		-- OLD FireServer(titleName)
		----------------------------------------------------

		if typeof(action) == "string"
			and typeof(value) ~= "string"
		then

			EquipTitle(
				player,
				action
			)

			return
		end

	end
)

------------------------------------------------------------
-- CUSTOMIZE REMOTE
------------------------------------------------------------

TitleCustomizeRemote.OnServerEvent:Connect(
	function(player, action, value)

		if action == "GetInventory" then

			SendTitleInventory(player)

			return
		end

		if action == "Equip" then

			EquipTitle(
				player,
				value
			)

			return
		end

		if action == "Unequip" then

			EquipTitle(
				player,
				""
			)

			return
		end

	end
)


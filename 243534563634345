------------------------------------------------------------
-- CHECK TITLE UNLOCKED
------------------------------------------------------------

local function IsTitleUnlocked(player, titleName)

	local title = TitleCache[titleName]

	if not title then
		return false
	end

	--------------------------------------------------------
	-- VIP
	--------------------------------------------------------

	if title.VIPOnly then
		return player:GetAttribute("HasVIP") == true
	end

	--------------------------------------------------------
	-- STREAK
	--------------------------------------------------------

	local leaderstats = player:FindFirstChild("leaderstats")

	if not leaderstats then
		return false
	end

	local bestStreak = leaderstats:FindFirstChild("BestStreak")

	if not bestStreak then
		return false
	end

	return bestStreak.Value >= title.Required
end

------------------------------------------------------------
-- TITLE DATA
------------------------------------------------------------

local function CreateTitleData(player)

	local folder = player:FindFirstChild("TitleData")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "TitleData"
		folder.Parent = player
	end

	--------------------------------------------------------
	-- EQUIPPED TITLE
	--------------------------------------------------------

	local equipped = folder:FindFirstChild("EquippedTitle")

	if not equipped then
		equipped = Instance.new("StringValue")
		equipped.Name = "EquippedTitle"
		equipped.Value = ""
		equipped.Parent = folder
	end

	--------------------------------------------------------
	-- OLD COMPATIBILITY VALUE
	--------------------------------------------------------

	local selected = folder:FindFirstChild("SelectedTitle")

	if not selected then
		selected = Instance.new("StringValue")
		selected.Name = "SelectedTitle"
		selected.Value = equipped.Value
		selected.Parent = folder
	end

	--------------------------------------------------------
	-- KEEP VALUES SYNCHRONIZED
	--------------------------------------------------------

	if equipped.Value == "" and selected.Value ~= "" then
		equipped.Value = selected.Value
	end

	if selected.Value == "" and equipped.Value ~= "" then
		selected.Value = equipped.Value
	end

	equipped.Changed:Connect(function(value)

		if selected.Value ~= value then
			selected.Value = value
		end

	end)

	selected.Changed:Connect(function(value)

		if equipped.Value ~= value then
			equipped.Value = value
		end

	end)

	--------------------------------------------------------
	-- INVENTORY
	--------------------------------------------------------

	local inventory = folder:FindFirstChild("OwnedTitles")

	if not inventory then
		inventory = Instance.new("Folder")
		inventory.Name = "OwnedTitles"
		inventory.Parent = folder
	end

	return folder, equipped, inventory
end

------------------------------------------------------------
-- UPDATE TITLE INVENTORY
------------------------------------------------------------

local function UpdateTitleInventory(player)

	local folder, _, inventory = CreateTitleData(player)

	for _, title in ipairs(Titles) do

		local owned = inventory:FindFirstChild(title.Name)

		local unlocked = IsTitleUnlocked(player, title.Name)

		if unlocked then

			if not owned then
				owned = Instance.new("BoolValue")
				owned.Name = title.Name
				owned.Value = true
				owned.Parent = inventory
			else
				owned.Value = true
			end

		elseif owned then

			owned:Destroy()

		end
	end

	return folder, inventory
end

------------------------------------------------------------
-- GET OWNED TITLES
------------------------------------------------------------

local function GetOwnedTitles(player)

	UpdateTitleInventory(player)

	local folder = player:FindFirstChild("TitleData")

	if not folder then
		return {}
	end

	local inventory = folder:FindFirstChild("OwnedTitles")

	if not inventory then
		return {}
	end

	local result = {}

	for _, title in ipairs(Titles) do

		if inventory:FindFirstChild(title.Name) then
			table.insert(result, title.Name)
		end

	end

	return result
end

